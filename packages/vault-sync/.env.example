# Vault Sync Configuration
# Copy to .env and customize

# Path to vault (default: ../../vault relative to this package)
VAULT_PATH=c:\Users\antho\Kiro Seraphim\vault

# Layer 1: Git sync
GIT_SYNC_ENABLED=true
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_COMMIT_INTERVAL=60000

# Layer 2: File watcher
WATCHER_ENABLED=true
WATCH_DEBOUNCE_MS=1000

# Layer 3: Obsidian REST API
OBSIDIAN_API_ENABLED=true
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_TOKEN=your-token-from-obsidian-settings

# Event Bus
EVENT_BUS_ENABLED=true
AWS_REGION=us-east-1
EVENT_BUS_NAME=seraphim-event-bus

# Dry run mode (logs events without publishing to EventBridge)
VAULT_SYNC_DRY_RUN=false
