{
  "name": "@seraphim/app",
  "version": "0.1.0",
  "private": true,
  "description": "Application layer: ZionX app factory, ZXMG media production, Zion Alpha trading",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zionx/*": {
      "types": "./dist/zionx/*",
      "default": "./dist/zionx/*"
    }
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@seraphim/core": "*",
    "@seraphim/drivers": "*",
    "@seraphim/services": "*",
    "e2b": "^2.27.1",
    "node-forge": "^1.4.0",
    "sharp": "^0.34.5"
  },
  "scripts": {
    "build": "tsc --build && node ../../scripts/copy-agent-assets.mjs",
    "test": "vitest run --config ../../vitest.config.ts --project app",
    "test:evals": "npm run build && node dist/zionx/app-development/agent/evals/cli.js",
    "test:evals:check": "npm run build && node dist/zionx/app-development/agent/evals/cli.js --baseline-check",
    "test:evals:update": "npm run build && node dist/zionx/app-development/agent/evals/cli.js --update-baseline",
    "lint": "eslint 'src/**/*.ts'",
    "clean": "tsc --build --clean && rm -rf dist"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node-forge": "^1.3.14"
  }
}
